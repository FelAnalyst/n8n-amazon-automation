    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT \n  SUM(COALESCE(sales7d, sales)) as total_sales,\n  SUM(cost) as total_cost,\n  ROUND((SUM(cost) / NULLIF(SUM(COALESCE(sales7d, sales)), 0)) * 100, 2) as acos_percentage\nFROM (\n  SELECT \n    sales7d,\n    NULL as sales,\n    cost,\n    date\n  FROM \"ads-api-reports\".ads_sp_campaigns_daily_reports\n  WHERE EXTRACT(MONTH FROM date) = {{ $json.month }}\n    AND EXTRACT(YEAR FROM date) = {{ $json.year }}\n    AND marketplace_id = 1\n  \n  UNION ALL\n  \n  SELECT \n    NULL as sales7d,\n    sales,\n    cost,\n    date\n  FROM \"ads-api-reports\".ads_sd_campaigns_reports\n  WHERE EXTRACT(MONTH FROM date) = {{ $json.month }}\n    AND EXTRACT(YEAR FROM date) = {{ $json.year }}\n    AND marketplace_id = 1\n  \n  UNION ALL\n  \n  SELECT \n    NULL as sales7d,\n    sales,\n    cost,\n    date\n  FROM \"ads-api-reports\".ads_sb_campaign_reports\n  WHERE EXTRACT(MONTH FROM date) = {{ $json.month }}\n    AND EXTRACT(YEAR FROM date) = {{ $json.year }}\n    AND marketplace_id = 1\n) combined",
