      "parameters": {
        "operation": "executeQuery",
        "query": "WITH \ntarget_date AS (\n    SELECT (DATE_TRUNC('month', MAKE_DATE({{ $json.year }}::int, {{ $json.month }}::int, 1)) + INTERVAL '1 month - 1 day')::DATE AS target_date\n),\n\n-- Базовий список товарів з ppc_id\nbase_products AS (\n    SELECT \n        mp.ppc_id,\n        mp.product_id,\n        mp.marketplace_id,\n        p.asin\n    FROM reference.marketplace_products mp\n    JOIN reference.products p ON mp.product_id = p.id\n    WHERE mp.ppc_id IS NOT NULL\n),\n\n-- ===== ЛОГІКА ДЛЯ MARKETPLACE_ID = 1 =====\nlatest_inventory_date_us AS (\n    SELECT MAX(snapshot_date) AS max_date \n    FROM \"sp-api-reports\".fba_inventory_reports_us\n    WHERE snapshot_date <= (SELECT target_date FROM target_date)\n),\nprimary_fnsku_us AS (\n    SELECT \n        f.asin,\n        f.fnsku AS primary_fnsku\n    FROM (\n        SELECT \n            f.asin,\n            f.fnsku,\n            ROW_NUMBER() OVER (PARTITION BY f.asin ORDER BY f.available DESC, f.fnsku) AS rn\n        FROM \"sp-api-reports\".fba_inventory_reports_us f\n        CROSS JOIN latest_inventory_date_us ld\n        WHERE f.snapshot_date = ld.max_date\n    ) f\n    WHERE f.rn = 1\n),\nmax_storage_month_us AS (\n    SELECT MAX(month_of_charge) AS max_month\n    FROM \"sp-api-reports\".fba_storage_fees_reports\n    WHERE year_of_charge = {{ $json.year }}\n        AND marketplace_id = 1\n        AND month_of_charge <= {{ $json.month }}\n),\nstorage_fee_us AS (\n    SELECT \n        sfr.fnsku,\n        sfr.fee_per_unit\n    FROM (\n        SELECT \n            sfr.fnsku,\n            CASE \n                WHEN sfr.average_quantity_on_hand > 0 \n                THEN sfr.estimated_monthly_storage_fee / sfr.average_quantity_on_hand\n                ELSE NULL \n            END AS fee_per_unit,\n            ROW_NUMBER() OVER (PARTITION BY sfr.fnsku ORDER BY sfr.fulfillment_center) AS rn\n        FROM \"sp-api-reports\".fba_storage_fees_reports sfr\n        CROSS JOIN max_storage_month_us msm\n        WHERE sfr.year_of_charge = {{ $json.year }}\n            AND sfr.marketplace_id = 1\n            AND sfr.month_of_charge = msm.max_month\n    ) sfr\n    WHERE sfr.rn = 1\n),\nmax_sales_date_us AS (\n    SELECT MAX(date) AS max_date\n    FROM \"sp-api-reports\".product_sales\n    WHERE marketplace_id = 1\n        AND date <= (SELECT target_date FROM target_date)\n),\nfba_qty_us AS (\n    SELECT \n        asin,\n        SUM(available) AS amazon_fba_qty\n    FROM \"sp-api-reports\".fba_inventory_reports_us\n    WHERE snapshot_date = (SELECT max_date FROM latest_inventory_date_us)\n        AND sku NOT LIKE '%amzn%'\n        AND sku NOT LIKE '%Amazon%'\n    GROUP BY asin\n),\nsales_forecast_us AS (\n    SELECT \n        p2.asin,\n        (SUM(ps.unit_count) / 30.0) * 75 AS forecast_75d\n    FROM \"sp-api-reports\".product_sales ps\n    JOIN reference.products p2 ON ps.product_id = p2.id\n    CROSS JOIN max_sales_date_us msd\n    WHERE ps.marketplace_id = 1\n        AND ps.date <= msd.max_date\n        AND ps.date > (msd.max_date - INTERVAL '30 days')\n    GROUP BY p2.asin\n),\noverhead_us AS (\n    SELECT \n        bp.ppc_id,\n        bp.marketplace_id,\n        ROUND(COALESCE(\n            FLOOR(GREATEST(COALESCE(fba.amazon_fba_qty, 0) - COALESCE(sf.forecast_75d, 0), 0)) * \n            COALESCE(stor.fee_per_unit, 0), 0\n        ), 2) AS overhead_spend\n    FROM base_products bp\n    LEFT JOIN fba_qty_us fba ON bp.asin = fba.asin\n    LEFT JOIN sales_forecast_us sf ON bp.asin = sf.asin\n    LEFT JOIN primary_fnsku_us pf ON bp.asin = pf.asin\n    LEFT JOIN storage_fee_us stor ON pf.primary_fnsku = stor.fnsku\n    WHERE bp.marketplace_id = 1\n),\n\n-- ===== ЛОГІКА ДЛЯ MARKETPLACE_ID = 2 =====\nlatest_inventory_date_eu AS (\n    SELECT MAX(report_date) AS max_date \n    FROM \"sp-api-reports\".multicountry_fba_inventory_reports\n    WHERE marketplace_id = 2\n        AND report_date <= (SELECT target_date FROM target_date)\n),\nprimary_fnsku_eu AS (\n    SELECT \n        f.asin,\n        f.fnsku AS primary_fnsku\n    FROM (\n        SELECT \n            f.asin,\n            f.fnsku,\n            ROW_NUMBER() OVER (PARTITION BY f.asin ORDER BY f.quantity_for_local_fulfillment DESC, f.fnsku) AS rn\n        FROM \"sp-api-reports\".multicountry_fba_inventory_reports f\n        CROSS JOIN latest_inventory_date_eu ld\n        WHERE f.report_date = ld.max_date\n            AND f.marketplace_id = 2\n    ) f\n    WHERE f.rn = 1\n),\nmax_storage_month_eu AS (\n    SELECT MAX(month_of_charge) AS max_month\n    FROM \"sp-api-reports\".fba_storage_fees_reports\n    WHERE year_of_charge = {{ $json.year }}\n        AND marketplace_id = 2\n        AND month_of_charge <= {{ $json.month }}\n),\nstorage_fee_eu AS (\n    SELECT \n        sfr.fnsku,\n        sfr.fee_per_unit\n    FROM (\n        SELECT \n            sfr.fnsku,\n            CASE \n                WHEN sfr.average_quantity_on_hand > 0 \n                THEN sfr.estimated_monthly_storage_fee / sfr.average_quantity_on_hand\n                ELSE NULL \n            END AS fee_per_unit,\n            ROW_NUMBER() OVER (PARTITION BY sfr.fnsku ORDER BY sfr.fulfillment_center) AS rn\n        FROM \"sp-api-reports\".fba_storage_fees_reports sfr\n        CROSS JOIN max_storage_month_eu msm\n        WHERE sfr.year_of_charge = {{ $json.year }}\n            AND sfr.marketplace_id = 2\n            AND sfr.month_of_charge = msm.max_month\n    ) sfr\n    WHERE sfr.rn = 1\n),\nmax_sales_date_eu AS (\n    SELECT MAX(date) AS max_date\n    FROM \"sp-api-reports\".product_sales\n    WHERE marketplace_id = 2\n        AND date <= (SELECT target_date FROM target_date)\n),\nfba_qty_eu AS (\n    SELECT \n        asin,\n        SUM(quantity_for_local_fulfillment) AS amazon_fba_qty\n    FROM \"sp-api-reports\".multicountry_fba_inventory_reports\n    WHERE report_date = (SELECT max_date FROM latest_inventory_date_eu)\n        AND marketplace_id = 2\n        AND sku NOT LIKE '%amzn%'\n        AND sku NOT LIKE '%Amazon%'\n    GROUP BY asin\n),\nsales_forecast_eu AS (\n    SELECT \n        p2.asin,\n        (SUM(ps.unit_count) / 30.0) * 75 AS forecast_75d\n    FROM \"sp-api-reports\".product_sales ps\n    JOIN reference.products p2 ON ps.product_id = p2.id\n    CROSS JOIN max_sales_date_eu msd\n    WHERE ps.marketplace_id = 2\n        AND ps.date <= msd.max_date\n        AND ps.date > (msd.max_date - INTERVAL '30 days')\n    GROUP BY p2.asin\n),\noverhead_eu AS (\n    SELECT \n        bp.ppc_id,\n        bp.marketplace_id,\n        ROUND(COALESCE(\n            FLOOR(GREATEST(COALESCE(fba.amazon_fba_qty, 0) - COALESCE(sf.forecast_75d, 0), 0)) * \n            COALESCE(stor.fee_per_unit, 0), 0\n        ), 2) AS overhead_spend\n    FROM base_products bp\n    LEFT JOIN fba_qty_eu fba ON bp.asin = fba.asin\n    LEFT JOIN sales_forecast_eu sf ON bp.asin = sf.asin\n    LEFT JOIN primary_fnsku_eu pf ON bp.asin = pf.asin\n    LEFT JOIN storage_fee_eu stor ON pf.primary_fnsku = stor.fnsku\n    WHERE bp.marketplace_id = 2\n)\n\n-- Фінальний результат\nSELECT \n    ppc_id,\n    marketplace_id,\n    ROUND(SUM(overhead_spend), 2) AS total_overhead_spend\nFROM (\n    SELECT ppc_id, marketplace_id, overhead_spend FROM overhead_us\n    UNION ALL\n    SELECT ppc_id, marketplace_id, overhead_spend FROM overhead_eu\n) combined\nGROUP BY ppc_id, marketplace_id\nORDER BY ppc_id, marketplace_id;",
