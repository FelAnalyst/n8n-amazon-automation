    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT \n  ads_totals.total_cost,\n  sales_totals.total_sales,\n  ROUND((ads_totals.total_cost / NULLIF(sales_totals.total_sales, 0)) * 100, 2) as acos_percentage\nFROM (\n  SELECT \n    SUM(cost) as total_cost\n  FROM (\n    SELECT cost, date\n    FROM \"ads-api-reports\".ads_sp_campaigns_daily_reports\n    WHERE EXTRACT(MONTH FROM date) = {{ $json.month }}\n      AND EXTRACT(YEAR FROM date) = {{ $json.year }}\n      AND marketplace_id = 1\n    \n    UNION ALL\n    \n    SELECT cost, date\n    FROM \"ads-api-reports\".ads_sd_campaigns_reports\n    WHERE EXTRACT(MONTH FROM date) = {{ $json.month }}\n      AND EXTRACT(YEAR FROM date) = {{ $json.year }}\n      AND marketplace_id = 1\n    \n    UNION ALL\n    \n    SELECT cost, date\n    FROM \"ads-api-reports\".ads_sb_campaign_reports\n    WHERE EXTRACT(MONTH FROM date) = {{ $json.month }}\n      AND EXTRACT(YEAR FROM date) = {{ $json.year }}\n      AND marketplace_id = 1\n  ) combined_ads\n) ads_totals\nCROSS JOIN (\n  SELECT \n    SUM(total_sales_amount) as total_sales\n  FROM \"sp-api-reports\".product_sales\n  WHERE EXTRACT(MONTH FROM date) = {{ $json.month }}\n    AND EXTRACT(YEAR FROM date) = {{ $json.year }}\n    AND marketplace_id = 1\n) sales_totals",
