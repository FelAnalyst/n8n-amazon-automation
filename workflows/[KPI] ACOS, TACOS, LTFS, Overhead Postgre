        "query": "WITH \ntarget_date AS (\n    SELECT (DATE_TRUNC('month', MAKE_DATE({{ $json.year }}::int, {{ $json.month }}::int, 1)) + INTERVAL '1 month - 1 day')::DATE AS target_date\n),\nlatest_inventory_date AS (\n    SELECT MAX(snapshot_date) AS max_date \n    FROM \"sp-api-reports\".fba_inventory_reports_us\n    WHERE snapshot_date <= (SELECT target_date FROM target_date)\n),\nprimary_fnsku_data AS (\n    SELECT \n        f.asin,\n        f.fnsku,\n        ROW_NUMBER() OVER (PARTITION BY f.asin ORDER BY f.available DESC, f.fnsku) AS rn\n    FROM \"sp-api-reports\".fba_inventory_reports_us f\n    CROSS JOIN latest_inventory_date ld\n    WHERE f.snapshot_date = ld.max_date\n),\nprimary_fnsku_only AS (\n    SELECT asin, fnsku AS primary_fnsku\n    FROM primary_fnsku_data\n    WHERE rn = 1\n),\nmax_storage_month AS (\n    SELECT MAX(month_of_charge) AS max_month\n    FROM \"sp-api-reports\".fba_storage_fees_reports\n    WHERE year_of_charge = {{ $json.year }}\n        AND marketplace_id = 1\n        AND month_of_charge <= {{ $json.month }}\n),\nstorage_fee_data AS (\n    SELECT \n        sfr.fnsku,\n        CASE \n            WHEN sfr.average_quantity_on_hand > 0 \n            THEN sfr.estimated_monthly_storage_fee / sfr.average_quantity_on_hand\n            ELSE NULL \n        END AS fee_per_unit,\n        ROW_NUMBER() OVER (PARTITION BY sfr.fnsku ORDER BY sfr.fulfillment_center) AS rn\n    FROM \"sp-api-reports\".fba_storage_fees_reports sfr\n    CROSS JOIN max_storage_month msm\n    WHERE sfr.year_of_charge = {{ $json.year }}\n        AND sfr.marketplace_id = 1\n        AND sfr.month_of_charge = msm.max_month\n),\nfirst_storage_record AS (\n    SELECT fnsku, fee_per_unit\n    FROM storage_fee_data\n    WHERE rn = 1\n),\nmax_sales_date AS (\n    SELECT MAX(date) AS max_date\n    FROM \"sp-api-reports\".product_sales\n    WHERE marketplace_id = 1\n        AND date <= (SELECT target_date FROM target_date)\n)\nSELECT \n    ROUND(SUM(ROUND(COALESCE(\n        FLOOR